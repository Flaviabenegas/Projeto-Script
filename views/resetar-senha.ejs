<!doctype html>
<html lang="pt-BR">
	<head>
		<%- include ('partials/head') %>
		<title>Redefinir Senha</title>
	</head>
	<body>
		<header><%- include ('partials/header') %></header>
		<main class="container mt-5 mb-5">
			<div class="row justify-content-center">
				<div class="col-12 col-md-8 col-lg-5">
					<div class="card shadow-sm">
						<div class="card-body p-4">
							<h2 class="text-center mb-1">Redefinir Senha</h2>
							<p class="text-center text-secondary small mb-4">
								Escolha uma nova senha para sua conta.
							</p>

							<% if (!token) { %>
							<div class="alert alert-danger text-center rounded-4">
								Link inválido ou expirado.<br />
								<a href="/" class="fw-medium">Voltar ao início</a>
							</div>
							<% } else { %>

							<div id="reset-container" data-token="<%= token %>">
								<div id="form-reset-wrap">
									<div class="mb-3">
										<label for="nova-senha" class="form-label">Nova senha</label>
										<div class="input-group">
											<span class="input-group-text"><i class="bi bi-lock"></i></span>
											<input
												type="password"
												class="form-control"
												id="nova-senha"
												placeholder="Mínimo 6 caracteres"
												minlength="6"
												required
											/>
										</div>
									</div>
									<div class="mb-3">
										<label for="confirmar-senha" class="form-label">Confirmar senha</label>
										<div class="input-group">
											<span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
											<input
												type="password"
												class="form-control"
												id="confirmar-senha"
												placeholder="Repita a nova senha"
												minlength="6"
												required
											/>
										</div>
									</div>
									<p id="reset-erro" class="small text-danger d-none text-center"></p>
									<div class="d-grid gap-2 mt-4">
										<button
											type="button"
											class="btn btn-pedido btn-lg fw-bold rounded-pill"
											id="btn-confirmar-reset"
										>
											<span id="btn-confirmar-text">Salvar nova senha</span>
											<output
												id="spinner-confirmar"
												class="spinner-border spinner-border-sm d-none"
											></output>
										</button>
									</div>
								</div>

								<div id="reset-sucesso" class="d-none text-center py-3">
									<span class="fs-1">✅</span>
									<p class="mt-3 fw-bold">Senha alterada com sucesso!</p>
									<p class="text-secondary small">Redirecionando para o início...</p>
								</div>
							</div>

							<% } %>
						</div>
					</div>
				</div>
			</div>
		</main>
		<footer><%- include ('partials/footer') %></footer>
		<%- include('partials/scripts') %>

		<%- include ('partials/modal') %>
		<script src="/script/esqueciSenha.js" defer></script>
		<script src="/script/resetarSenha.js" defer></script>
	</body>
</html>
