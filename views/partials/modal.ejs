<div class="modal fade" id="modalAdicionarAdmin" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-bottom-0 pb-0">
				<h5 class="modal-title titulos fw-bold">Novo Administrador</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form id="formAdicionarAdmin">
					<div class="mb-3">
						<label for="novoAdminNome" class="form-label text-secondary small mb-1">Nome:</label>
						<input
							type="text"
							class="form-control rounded-pill"
							id="novoAdminNome"
							placeholder="Ex: João Silva" />
					</div>
					<div class="mb-3">
						<label for="novoAdminEmail" class="form-label text-secondary small mb-1"
							>E-mail (Login): <span class="text-danger">*</span></label
						>
						<input
							type="email"
							class="form-control rounded-pill"
							id="novoAdminEmail"
							placeholder="email@exemplo.com"
							required />
					</div>
					<div class="mb-3">
						<label for="novoAdminSenha" class="form-label text-secondary small mb-1"
							>Palavra-passe: <span class="text-danger">*</span></label
						>
						<input
							type="password"
							class="form-control rounded-pill"
							id="novoAdminSenha"
							placeholder="Mínimo 6 caracteres"
							required
							minlength="6" />
					</div>
					<div class="form-check form-switch mt-3">
						<input class="form-check-input" type="checkbox" id="novoAdminIsAdmin" checked />
						<label class="form-check-label text-secondary small" for="novoAdminIsAdmin"
							>Dar permissões de Administrador imediatamente</label
						>
					</div>
				</form>
			</div>
			<div class="modal-footer border-top-0 pt-0">
				<button
					type="button"
					class="btn btn-outline-secondary rounded-pill px-4"
					data-bs-dismiss="modal">
					Cancelar
				</button>
				<button type="button" class="btn btn-primary rounded-pill px-4" id="btnSalvarNovoAdmin">
					Adicionar
				</button>
			</div>
		</div>
	</div>
</div>
