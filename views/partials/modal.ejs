<div class="modal fade" id="modalDetalhesPedido" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg modal-dialog-centered">
		<div class="modal-content rounded-4 border-0 shadow">
			<div class="modal-header border-bottom-0 pb-0">
				<h5 class="modal-title titulos fw-bold">Detalhes do Pedido</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" id="conteudoDetalhesPedido"></div>
			<div class="modal-footer border-top-0 pt-0">
				<button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
					Fechar
				</button>
			</div>
		</div>
	</div>
</div>

<div
	class="modal fade"
	id="modalLogin"
	tabindex="-1"
	aria-labelledby="modalLoginLabel"
	aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 rounded-4 shadow-lg">
			<div class="modal-header azul-claro border-0 rounded-4 p-4">
				<h5 class="modal-title fw-bold" id="modalLoginLabel">Painel Administrativo</h5>
				<button
					type="button"
					class="btn-close rounded-pill titulos"
					data-bs-dismiss="modal"
					aria-label="Close"></button>
			</div>
			<div class="modal-body p-4">
				<form id="loginPainel">
					<div class="mb-3">
						<label for="email-login" class="form-label fw-medium">E-mail</label>
						<input
							type="email"
							class="form-control rounded-4"
							id="email-login"
							placeholder="nome@exemplo.com"
							required />
					</div>
					<div class="mb-3">
						<label for="senha" class="form-label fw-medium">Senha</label>
						<input
							type="password"
							class="form-control rounded-4"
							id="senha"
							placeholder="Sua senha secreta"
							required />
					</div>
					<button type="submit" class="btn btn-pet w-100 rounded-pill py-2 fw-bold" id="btn-login">
						Entrar na conta
					</button>
					<p class="text-center mt-3 mb-0 small">
						Não possui usuário?
						<a href="/users" class="fw-medium">Clique aqui para criar</a>
					</p>
				</form>
			</div>
		</div>
	</div>
</div>

<div id="loader" class="d-none opacity-0" style="transition: opacity 0.5s ease">
	<div class="d-flex flex-column align-items-center my-3">
		<output class="spinner-border text-primary" aria-label="status"></output>
		<span class="mt-2">Autenticando...</span>
	</div>
</div>

