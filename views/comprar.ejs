<!doctype html>
<html lang="pt-BR">
	<head>
		<%- include ('partials/head') %>
	</head>
	<body>
		<header><%- include ('partials/header') %></header>
		<main>
			<!-- ── TOPO DA PÁGINA ───────────────────────────────── -->
			<section class="container text-center pt-6 pb-2 pt-md-5">
				<div class="row justify-content-center">
					<div class="col-lg-7">
						<p class="text-secondary small mb-1">
							<a href="/" class="text-decoration-none text-secondary">Início</a>
							<span class="mx-1">›</span> Comprar
						</p>
						<h1 class="titulos display-5 fw-bold mb-3">Feitos para latidos e miados 🐶🐱</h1>
						<p class="lead text-secondary">
							O mesmo cuidado, a mesma qualidade. Escolha o modelo ideal para o seu companheiro por
							um <strong class="titulos-rosa">valor único</strong>.
						</p>
					</div>
				</div>
			</section>

			<!-- ── MODELOS ───────────────────────────────────────── -->
			<section class="container py-4 py-md-5" id="modelos-e-valores">
				<div class="row justify-content-center align-items-stretch g-4">
					<div class="col-md-5 col-lg-4">
						<div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
							<div class="card-body text-center p-4 d-flex flex-column">
								<span class="badge azul-claro rounded-pill mb-4 px-3 py-2 align-self-center"
									>Modelo Cão</span
								>
								<img
									loading="lazy"
									src="img/medalha-cao.webp"
									alt="Plaquinha formato osso para Cachorro"
									class="img-fluid rounded-3 mb-4 mx-auto"
									style="height: 180px; object-fit: contain" />
								<h4 class="fw-bold titulos">Formato Osso</h4>
								<p class="text-secondary small mt-auto mb-0">
									Proporcional e visível. Tamanho ideal para não incomodar no pescoço do seu cão
									durante as brincadeiras.
								</p>
							</div>
						</div>
					</div>

					<div class="col-md-5 col-lg-4">
						<div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
							<div class="card-body text-center p-4 d-flex flex-column">
								<span class="badge azul-claro rounded-pill mb-4 px-3 py-2 align-self-center"
									>Modelo Gato</span
								>
								<img
									loading="lazy"
									src="img/medalha-gato.webp"
									alt="Plaquinha redonda para Gato"
									class="img-fluid rounded-3 mb-4 mx-auto"
									style="height: 180px; object-fit: contain" />
								<h4 class="fw-bold titulos">Formato Redondo</h4>
								<p class="text-secondary small mt-auto mb-0">
									Leve e compacta. Desenhada estritamente para não atrapalhar a agilidade e os
									movimentos dos felinos.
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- Preço -->
				<div class="row justify-content-center mt-5">
					<div class="col-lg-6 text-center mb-3">
						<div class="p-4 border-start border-5 border-custom rounded-4 bg-light shadow-sm">
							<p class="text-uppercase fw-bold text-secondary mb-1">Investimento na Segurança</p>
							<h2 class="display-3 fw-bold titulos-rosa mb-4">R$ 15,00</h2>
							<ul class="list-unstyled mb-4 text-start d-inline-block">
								<li class="mb-2">
									<i class="text-success fw-bold me-2">✓</i> Gravação que não apaga
								</li>
								<li class="mb-2">
									<i class="text-success fw-bold me-2">✓</i> Argola de fixação resistente inclusa
								</li>
								<li class="mb-2">
									<i class="text-success fw-bold me-2">✓</i> O mesmo valor para qualquer modelo
								</li>
								<li class="mb-2">
									<i class="text-success fw-bold me-2">✓</i> Frete grátis a partir de 3 plaquinhas
									para Mogi Mirim
								</li>
							</ul>
							<br />
							<a href="#compra" class="btn btn-lg btn-pet rounded-pill fw-bold px-5 py-3 shadow">
								Garantir a Plaquinha Agora
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- ── FAQ ───────────────────────────────────────────── -->
			<section class="container py-4 py-md-5" id="faq">
				<h2 class="titulos text-center mb-4 display-6">Dúvidas Frequentes</h2>
				<div class="row justify-content-center">
					<div class="col-lg-8">
						<div class="accordion accordion-flush" id="accordionFAQ">
							<div
								class="accordion-item border border-1 border-light-subtle mb-3 rounded-4 shadow-sm bg-white overflow-hidden">
								<h2 class="accordion-header" id="faq-headingOne">
									<button
										class="accordion-button collapsed fw-bold titulos bg-white"
										type="button"
										data-bs-toggle="collapse"
										data-bs-target="#faq-collapseOne"
										aria-expanded="false"
										aria-controls="faq-collapseOne">
										Por que é tão importante identificar meu pet?
									</button>
								</h2>
								<div
									id="faq-collapseOne"
									class="accordion-collapse collapse"
									aria-labelledby="faq-headingOne"
									data-bs-parent="#accordionFAQ">
									<div class="accordion-body text-secondary">
										Um pet com identificação tem
										<span class="fw-bold titulos-rosa">90% mais chances</span> de retornar ao lar em
										menos de 24 horas. É a forma mais ágil de quem encontrou seu pet entrar em
										contato com você, garantindo a segurança dele em fugas ou passeios.
									</div>
								</div>
							</div>

							<div
								class="accordion-item border border-1 border-light-subtle mb-3 rounded-4 shadow-sm bg-white overflow-hidden">
								<h2 class="accordion-header" id="faq-headingTwo">
									<button
										class="accordion-button collapsed fw-bold titulos bg-white"
										type="button"
										data-bs-toggle="collapse"
										data-bs-target="#faq-collapseTwo"
										aria-expanded="false"
										aria-controls="faq-collapseTwo">
										As plaquinhas são duráveis?
									</button>
								</h2>
								<div
									id="faq-collapseTwo"
									class="accordion-collapse collapse"
									aria-labelledby="faq-headingTwo"
									data-bs-parent="#accordionFAQ">
									<div class="accordion-body text-secondary">
										Sim! Nossas identificações possuem durabilidade extrema. A gravação com o seu
										número e o nome do pet não desbota com o tempo e é totalmente à prova de
										aventuras, seja chuva, brincadeiras na terra ou corridas.
									</div>
								</div>
							</div>

							<div
								class="accordion-item border border-1 border-light-subtle mb-3 rounded-4 shadow-sm bg-white overflow-hidden">
								<h2 class="accordion-header" id="faq-headingThree">
									<button
										class="accordion-button collapsed fw-bold titulos bg-white"
										type="button"
										data-bs-toggle="collapse"
										data-bs-target="#faq-collapseThree"
										aria-expanded="false"
										aria-controls="faq-collapseThree">
										Serve tanto para cachorros quanto para gatos?
									</button>
								</h2>
								<div
									id="faq-collapseThree"
									class="accordion-collapse collapse"
									aria-labelledby="faq-headingThree"
									data-bs-parent="#accordionFAQ">
									<div class="accordion-body text-secondary">
										Com certeza! Temos modelos que ficam perfeitos e confortáveis tanto para
										cãezinhos de porte mini, como a Chihuahua Millie, quanto para gatinhas cheias de
										personalidade, como a Lola e a Charlotte.
									</div>
								</div>
							</div>

							<div
								class="accordion-item border border-1 border-light-subtle mb-3 rounded-4 shadow-sm bg-white overflow-hidden">
								<h2 class="accordion-header" id="faq-headingFour">
									<button
										class="accordion-button collapsed fw-bold titulos bg-white"
										type="button"
										data-bs-toggle="collapse"
										data-bs-target="#faq-collapseFour"
										aria-expanded="false"
										aria-controls="faq-collapseFour">
										O que será gravado na plaquinha?
									</button>
								</h2>
								<div
									id="faq-collapseFour"
									class="accordion-collapse collapse"
									aria-labelledby="faq-headingFour"
									data-bs-parent="#accordionFAQ">
									<div class="accordion-body text-secondary">
										Gravamos o nome do seu pet em destaque e, no verso, o número de telefone de
										contato que você informar no formulário de pedido.
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- ── FORMULÁRIO DE PEDIDO ──────────────────────────── -->
			<section class="comprar py-4 py-md-5">
				<div class="container mt-2">
					<div class="card shadow">
						<div class="card-header bg-custom">
							<h4 class="mb-0" id="compra">Formulário de Pedido</h4>
						</div>
						<div class="card-body">
							<form id="formPedido">
								<fieldset class="mb-4">
									<legend class="text-secondary h5 mb-3">Informações do Tutor</legend>
									<div class="row g-3">
										<div class="col-md-6">
											<label for="nome" class="form-label">Nome Completo</label>
											<input
												type="text"
												class="form-control"
												id="nome"
												placeholder="Digite seu nome"
												required />
										</div>
										<div class="col-md-6">
											<label for="cpf" class="form-label">
												CPF
												<span
													class="tooltip-icon"
													aria-hidden="true"
													data-tooltip="Precisamos do seu CPF para garantir que você é uma pessoa real"
													>?</span
												>
											</label>
											<input
												type="text"
												class="form-control"
												id="cpf"
												placeholder="000.000.000-00"
												required />
										</div>
										<div class="col-md-6">
											<label for="telefone" class="form-label">Telefone de Contato</label>
											<input
												type="tel"
												class="form-control"
												id="telefone"
												placeholder="(00) 00000-0000"
												required />
										</div>
										<div class="col-md-6">
											<label for="form-email" class="form-label">E-mail</label>
											<input
												type="email"
												class="form-control"
												id="form-email"
												placeholder="nome@exemplo.com"
												required />
										</div>
									</div>
								</fieldset>

								<hr class="my-4" />

								<fieldset class="border p-4 rounded-3 mb-4 shadow-sm">
									<legend class="text-secondary h5 mb-3">Dados para Envio</legend>
									<div class="row g-3">
										<div class="col-md-6">
											<label for="cep" class="form-label fw-semibold">CEP</label>
											<div class="input-group">
												<input
													type="text"
													class="form-control"
													id="cep"
													placeholder="00000-000"
													required />
												<button type="button" class="btn btn-pet px-3" id="buscarCep">
													Buscar CEP
												</button>
											</div>
										</div>

										<div class="col-md-6 d-none d-md-block"></div>

										<div class="col-md-9">
											<label for="logradouro" class="form-label fw-semibold">Logradouro</label>
											<input
												type="text"
												class="form-control"
												id="logradouro"
												placeholder="Rua, Avenida, Travessa..."
												required />
										</div>

										<div class="col-md-3">
											<label for="numero" class="form-label fw-semibold">Número</label>
											<input
												type="text"
												class="form-control"
												id="numero"
												placeholder="Ex: 123"
												required />
										</div>

										<div class="col-md-3">
											<label for="complemento" class="form-label fw-semibold">Complemento</label>
											<input
												type="text"
												class="form-control"
												id="complemento"
												placeholder="Apto, Bloco..." />
										</div>

										<div class="col-md-3">
											<label for="bairro" class="form-label fw-semibold">Bairro</label>
											<input type="text" class="form-control" id="bairro" required />
										</div>

										<div class="col-md-4">
											<label for="cidade" class="form-label fw-semibold">Cidade</label>
											<input type="text" class="form-control" id="cidade" required />
										</div>

										<div class="col-md-2">
											<label for="uf" class="form-label fw-semibold">Estado</label>
											<select class="form-select" id="uf" required>
												<option value="" selected disabled>UF</option>
												<option value="AC">AC</option>
												<option value="AL">AL</option>
												<option value="AP">AP</option>
												<option value="AM">AM</option>
												<option value="BA">BA</option>
												<option value="CE">CE</option>
												<option value="DF">DF</option>
												<option value="ES">ES</option>
												<option value="GO">GO</option>
												<option value="MA">MA</option>
												<option value="MT">MT</option>
												<option value="MS">MS</option>
												<option value="MG">MG</option>
												<option value="PA">PA</option>
												<option value="PB">PB</option>
												<option value="PR">PR</option>
												<option value="PE">PE</option>
												<option value="PI">PI</option>
												<option value="RJ">RJ</option>
												<option value="RN">RN</option>
												<option value="RS">RS</option>
												<option value="RO">RO</option>
												<option value="RR">RR</option>
												<option value="SC">SC</option>
												<option value="SP">SP</option>
												<option value="SE">SE</option>
												<option value="TO">TO</option>
											</select>
										</div>
									</div>
								</fieldset>

								<fieldset>
									<legend class="text-secondary h5 mb-3">Detalhes das Plaquinhas</legend>
									<div class="row g-3">
										<div class="col-md-3">
											<label for="qtdCao" class="form-label">Qtd. Cão 🐶</label>
											<input
												type="number"
												class="form-control"
												id="qtdCao"
												min="0"
												value="1"
												required />
										</div>
										<div class="col-md-3">
											<label for="qtdGato" class="form-label">Qtd. Gato 🐱</label>
											<input
												type="number"
												class="form-control"
												id="qtdGato"
												min="0"
												value="0"
												required />
										</div>
										<div class="col-md-3">
											<label for="valorTotal" class="form-label">Valor Total</label>
											<div class="input-group">
												<span class="input-group-text bg-light">R$</span>
												<input
													type="text"
													class="form-control fw-bold text-primary bg-light"
													id="valorTotal"
													value="15,00"
													readonly />
											</div>
										</div>
										<div class="col-md-12">
											<label for="nomePets" class="form-label">Nome(s) do(s) Pet(s)</label>
											<input
												type="text"
												class="form-control"
												id="nomePets"
												placeholder="Ex: Rex, Luna, Simba"
												required />
										</div>
										<div class="col-12">
											<label for="telGravacao" class="form-label">
												Telefone para Gravação (na plaquinha)
											</label>
											<span class="tooltip-icon" data-tooltip="Número que será gravado na plaquinha"
												>?</span
											>
											<input
												type="tel"
												class="form-control"
												id="telGravacao"
												placeholder="Qual número deve ser gravado?"
												required />
										</div>
									</div>
								</fieldset>

								<div class="mt-4 d-grid">
									<button
										type="submit"
										class="btn btn-pedido btn-lg fw-bold rounded-pill"
										id="btn-comprar">
										<span id="btn-text">ENVIAR PEDIDO</span>
										<div
											id="spinner"
											class="spinner-border spinner-border-sm d-none"
											role="status"></div>
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</section>
		</main>
		<footer class="bg-light text-center"><%- include ('partials/footer') %></footer>

		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
			crossorigin="anonymous"></script>

		<%- include ('partials/modal') %>

		<!-- Modal: Pedido Enviado -->
		<div class="modal fade" id="modalSucesso" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content border-0 rounded-4 shadow-lg">
					<div class="modal-header bg-success text-white border-0 rounded-top-4 p-4">
						<h5 class="modal-title fw-bold">Sucesso! 🎉</h5>
						<button
							type="button"
							class="btn-close btn-close-white"
							data-bs-dismiss="modal"
							aria-label="Close"></button>
					</div>
					<div class="modal-body p-4 text-center">
						<p class="fs-5 mb-0 text-secondary">Pedido enviado com sucesso!</p>
					</div>
					<div class="modal-footer border-0 justify-content-center pb-4">
						<button
							type="button"
							class="btn btn-success rounded-pill px-4 fw-bold"
							data-bs-dismiss="modal">
							Entendi
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- Modal: CPF Inválido -->
		<div class="modal fade" id="modalErro" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content border-0 rounded-4 shadow-lg">
					<div class="modal-header bg-danger text-white border-0 rounded-top-4 p-4">
						<h5 class="modal-title fw-bold">Atenção ❌</h5>
						<button
							type="button"
							class="btn-close btn-close-white"
							data-bs-dismiss="modal"
							aria-label="Close"></button>
					</div>
					<div class="modal-body p-4 text-center">
						<p class="fs-5 mb-0 text-secondary" id="modalText">
							CPF Inválido. Por favor, verifique os dados.
						</p>
					</div>
					<div class="modal-footer border-0 justify-content-center pb-4">
						<button
							type="button"
							class="btn btn-danger rounded-pill px-4 fw-bold"
							data-bs-dismiss="modal">
							Tentar novamente
						</button>
					</div>
				</div>
			</div>
		</div>

		<script src="script/buscaCep.js" defer></script>
		<script src="script/painel.js" defer></script>
		<script src="script/email.js" defer></script>
		<script src="script/validar.js" defer></script>
	</body>
</html>
