<!doctype html>
<html lang="pt-BR">
	<head>
		<title><%= status %> - <%= titulo %></title>
		<%- include ('partials/head') %>
	</head>
	<body>
		<header><%- include ('partials/header') %></header>
		<main>
			<section class="container text-center my-5">
				<div>
					<img
						src="../img/tristes.webp"
						alt="cachorras tristes"
						class="img-fluid mt-4"
						style="max-width: 400px"
					/>
				</div>
				<h1 class="display-4"><%= status %> - <%= titulo %></h1>
				<p class="lead"><%= mensagem %></p>
				<a href="/" class="btn btn-primary">Voltar para a Página Inicial</a>
			</section>
		</main>
		<footer class="bg-light text-center"><%- include ('partials/footer') %></footer>

		<%- include('partials/script') %>

		<%- include ('partials/modal') %>

		<script src="script/painel.js" defer></script>
		<script src="script/email.js" defer></script>
		<script src="/script/esqueciSenha.js" defer></script>
		<script src="/script/resetarSenha.js" defer></script>
	</body>
</html>
