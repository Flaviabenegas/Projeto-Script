<!doctype html>
<html lang="pt-BR">
	<head>
		<%- include ('partials/head') %>
	</head>
	<body>
		<header><%- include ('partials/header') %></header>
		<main>
			
			<section class="container text-center pt-6 pb-2 pt-md-5">
				<div class="row justify-content-center">
					<div class="col-lg-7">
						<p class="text-secondary small mb-1">
							<a href="/" class="text-decoration-none text-secondary">Início</a>
							<span class="mx-1">›</span> Depoimentos
						</p>
						<h1 class="titulos display-5 fw-bold mb-3">O que alguns clientes dizem</h1>
						<p class="lead text-secondary">
							Histórias reais de tutores que garantiram a segurança dos seus pets.
						</p>
					</div>
				</div>
			</section>

			
			<div class="row row-cols-1 row-cols-md-3 g-4">
    <% depoimentos.forEach(function(depoimento) { %>
        <div class="col">
            <div class="card cards shadow-sm h-100">
                <img
                    loading="lazy"
                    src="<%= depoimento.imagem %>"
                    class="card-img-top"
                    alt="<%= depoimento.alt %>" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title"><%= depoimento.tutor %>, tutora da/do <%= depoimento.pet %></h5>
                    <p class="card-text flex-grow-1">
                        <%= depoimento.texto %>
                    </p>
                                    </div>
            </div>
        </div>
    <% }); %>
</div>

				
				<div class="text-center mt-5 pt-2">
					<a href="/comprar" class="btn btn-pet btn-lg px-5 py-3 rounded-pill fw-bold shadow">
						Garantir minha plaquinha — R$ 15,00 🐾
					</a>
				</div>
			</section>
		</main>
		<footer class="bg-light text-center"><%- include ('partials/footer') %></footer>

		<script
			src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
			crossorigin="anonymous"></script>

		<%- include ('partials/modal') %>

		<script src="script/email.js" defer></script>
		<script src="script/painel.js" defer></script>
	</body>
</html>
